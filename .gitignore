### VS Code ###
.vscode/
# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# agent
.ai/
.trellis/
.opencode/
.omo/
.codegraph/
.playwright-mcp/

# secrets / keys
**/src/main/resources/keys/*.key
**/keys/*.key
# Production values kept outside deploy/docker/.env; pass them with `docker compose --env-file <path>`.
.env.prod.secrets
# Anything else dropped next to the compose files (.env.local, .env.prod, .env.bak, .env.prod.secrets)
# is a copy of live credentials. Templates (`*.example`) are the only tracked files in this folder.
deploy/docker/.env*
!deploy/docker/*.example
# MySQL dumps written by deploy/bin/backup_mysql.sh (host state, may hold personal data).
/deploy/backups/

# Scripts tracked: root bin/ (launch start-* + bin/dev dev tooling) and deploy/bin/ (ops/deploy).
# The generic `bin/` rule above ignores ANY `bin` directory, so re-include both explicitly
# (anchored patterns). Passwords in these scripts are initial/default dev values (safe to expose).
!/bin/
!/bin/**
!deploy/bin/
!deploy/bin/**
# Runtime state written by the launch scripts (window PIDs) - never tracked.
bin/.run/
# Dev-only assets under bin/dev/ (dev keys, LOCAL backend storage). The `!/bin/**` negation above
# re-included them, so they must be ignored again *after* it.
bin/dev/common-dev-secrets.yml
bin/dev/resource-storage/
# Python E2E/AI test course scripts (bin/test): local venv, caches, run artifacts - never tracked.
bin/test/.venv/
bin/test/__pycache__/
bin/test/.pytest_cache/
bin/test/artifacts/
# Archived run results (JSONL) - regenerated by every run, never committed.
bin/test/results/
# Case/ledger export products - regenerated from results/, except the final ledger.
bin/test/cases/*
!bin/test/cases/test-ledger.xlsx
bin/test/reports/
# Tool state inside bin/test — re-included by the `!/bin/**` negation above, so list explicitly.
bin/test/.omo/
bin/test/.codegraph/
# Demo cache.
demo/__pycache__/

# Plugin docs are independently built & published artifacts (one sub-dir per plugin, synced by the
# docs repo's pipeline) - not source. Keep deploy/plugin-docs/README.md (the mount<->base contract).
/deploy/plugin-docs/*/

# LOCAL storage backend (nitrowater-resource, app.resource.backend=local) writes uploaded objects to
# bin/dev/resource-storage/ at runtime - generated dev data, ignored above.
# Docs are never build inputs for the jar: NitroWater is a markdown-only corpus (ai/docs), and
# published sites are deploy artifacts handled dynamically. Anything under static/docs is a stale
# local build - never commit it. See deploy/plugin-docs/ + bin/dev/sync-docs.ps1.
/nitrowater-server/src/main/resources/static/docs/

# Decoupled deploy content: violation word lists and external doc corpora are mounted at runtime
# (docker-compose.app.yml), maintained outside this public repo. Only the contract (README) and
# the folder placeholders stay tracked. See deploy/content/README.md.
/deploy/content/*
!/deploy/content/README.md
!/deploy/content/.gitkeep
!/deploy/content/moderation/
!/deploy/content/moderation/.gitkeep
!/deploy/content/docs/
!/deploy/content/docs/.gitkeep
