# Copy to `.env.local` (git-ignored) and adjust per environment.
# These values are read in src/auth/oidc.ts; all are optional and fall back to local defaults.

# OIDC authority = the SSO Authorization Server issuer.
# MUST equal the server's jwt.issuer / JWT_ISSUER, or oidc-client-ts rejects the metadata.
# dev:  http://localhost:8090   prod: https://auth.nitrowater.cn
VITE_OIDC_AUTHORITY=http://localhost:8090

# Registered OIDC client id (public client, PKCE).
VITE_OIDC_CLIENT_ID=nitrowater-web

# Optional overrides (default to <origin>/auth/callback and <origin>/):
# VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
# VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
