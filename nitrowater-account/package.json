{
  "name": "nitrowater-account-ui",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:admin": "pnpm --filter admin-ui dev",
    "dev:auth": "pnpm --filter auth-ui dev",
    "build": "pnpm --filter admin-ui --filter auth-ui build",
    "build:admin": "pnpm --filter admin-ui build",
    "build:auth": "pnpm --filter auth-ui build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  }
}
