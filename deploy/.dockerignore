# Build context for the deploy kit image (docker-bake.hcl target "kit", context = ./deploy).
# Only the 20-ish files the host actually needs get in; everything else here is either
# host-only state (secrets, live .env copies) or bulky data (plugin docs, corpora).

# Live env files. The template stays: a fresh host restores .env from it.
.env
**/.env
**/.env.*
!docker/.env.example
**/*.secrets

# Private keys are generated on the host by deploy/bin/gen-keys.sh.
keys/*.key

# Built plugin docs (~1.8 MB of static HTML) are data, not part of the kit.
plugin-docs/

# Runtime content (word lists, AI corpora) stays on the host; keep the placeholders only.
content/moderation/*
content/docs/*
!content/moderation/.gitkeep
!content/docs/.gitkeep
