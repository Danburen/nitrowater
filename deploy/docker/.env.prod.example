# ============================================================
# NitroWater 生产环境变量模板（唯一模板）
#
# 用法：
#   cp deploy/docker/.env.prod.example deploy/docker/.env
#   # 把所有 YOUR_*_HERE 换成真实值
#   bash deploy/bin/check-env.sh          # 必须 0 FAIL
#   然后按 infra -> account -> app 手工启动（见文件末）
#
# 三条规则：
#   1. 只有 docker-compose.*.yml 的 environment: 里出现的键才会进容器。
#   2. 不要在值后面写行内注释（# 会被当成值的一部分）。
#   3. YOUR_*_HERE 表示未配置；check-env 会 FAIL。用不到的整段注释掉。
#
# 生成随机值：
#   openssl rand -base64 32   # NITROWATER_KEK
#   openssl rand -hex 32      # DEVICE_SALT / BFF_CLIENT_SECRET
#   openssl rand -base64 24   # DB_PASSWORD / REDIS_PASSWORD
# ============================================================

# ---------------- 1. 共享基础 ----------------
# MySQL root 口令；首次初始化后修改需同步处理数据卷。
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
# 业务连接账号；生产建议按库建最小权限账号（需先在 MySQL 里建好）。
DB_USERNAME=root
# Redis 口令：存放 BFF 会话与令牌，生产必须非空。
REDIS_PASSWORD=YOUR_REDIS_PASSWORD_HERE
# 业务端口只绑回环，公网只经 edge 的 80/443 进入。
PUBLISH_BIND=127.0.0.1
# 运维 UI（Qdrant / SeaweedFS）只绑回环；禁止 0.0.0.0。
OPS_BIND=127.0.0.1

# ---------------- 2. 身份 / SSO ----------------
# 浏览器与服务都可达的 issuer，必须与 AUTH_DOMAIN 一致。
JWT_ISSUER=https://auth.example.com
# 32 字节 Base64；丢失后加密列不可解，生成后离线备份。
NITROWATER_KEK=YOUR_32BYTE_BASE64_KEK_HERE
# 设备指纹盐；禁止使用 dev 默认值。
DEVICE_SALT=YOUR_RANDOM_DEVICE_SALT_HERE
# BFF 的 OIDC client secret；account 启动时 upsert。
BFF_CLIENT_SECRET=YOUR_BFF_CLIENT_SECRET_HERE
# 登录回调；必须与浏览器实际地址完全一致。
BFF_REDIRECT_URIS=https://example.com/login/oauth2/code/nitrowater
# 登出回跳；必须包含在 BFF_POST_LOGOUT_REDIRECT_URIS 列表里。
BFF_POST_LOGOUT_REDIRECT_URIS=https://example.com,https://example.com/
# 登录后默认跳转。
SSO_DEFAULT_REDIRECT=https://example.com
# 登录表单的 CSP form-action 白名单。
SSO_FORM_ACTION_ORIGINS=https://example.com,https://auth.example.com
# BFF 登出目标；必须与上面的登出列表一致。
POST_LOGOUT_REDIRECT_URI=https://example.com
# 走 HTTPS 时必须 true。
SESSION_COOKIE_SECURE=true

# ---------------- 3. 验证码发送 ----------------
# 生产必须 real；mock 会把验证码写进日志。
COMMUNICATION_MODE=real
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_SMTP_USER_HERE
MAIL_PASSWORD=YOUR_SMTP_PASSWORD_HERE
MAIL_FROM=no-reply@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
ALIBABA_CLOUD_ACCESS_KEY_ID=YOUR_ALIYUN_ACCESS_KEY_ID_HERE
ALIBABA_CLOUD_ACCESS_KEY_SECRET=YOUR_ALIYUN_ACCESS_KEY_SECRET_HERE
ALIYUN_SMS_SIGN_NAME=YOUR_SMS_SIGN_NAME_HERE
ALIYUN_SMS_TEMPLATE_CODE=YOUR_SMS_TEMPLATE_CODE_HERE
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com

# ---------------- 4. 边缘 / 域名 ----------------
# 主站域名；www 也要写进列表才会一起签证书。
WEB_DOMAIN=example.com
# SSO 子域；必须与 JWT_ISSUER 的主机名一致。
AUTH_DOMAIN=auth.example.com
# Let's Encrypt 联系邮箱。
SSL_EMAIL=ops@example.com

# ---------------- 5. 对象存储 ----------------
# s3 | cos | local。
RESOURCE_BACKEND=s3
S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY_HERE
S3_SECRET_KEY=YOUR_S3_SECRET_KEY_HERE
S3_BUCKET=nitrowater
# 浏览器可达的 S3 地址；留 localhost 时内联图片在生产打不开。
S3_PUBLIC_ENDPOINT=https://fs.example.com
# presigned URL 缓存余量（秒）。
RESOURCE_CACHE_MARGIN=60
# 用户上传开关；审核流程上线前保持 false（接口返回 503）。
RESOURCE_USER_UPLOAD=false
# 普通上传 / 插件 jar 上限（字节）。
RESOURCE_MAX_SIZE=10485760
RESOURCE_PLUGIN_MAX_SIZE=67108864
# 内部发布通道；留空则 /internal 发布关闭（503）。
RESOURCE_INTERNAL_TOKEN=YOUR_INTERNAL_PUBLISH_TOKEN_HERE
# 仅 RESOURCE_BACKEND=cos 时需要；用 s3 就整段注释。
# COS_SECRET_ID=YOUR_COS_SECRET_ID_HERE
# COS_SECRET_KEY=YOUR_COS_SECRET_KEY_HERE
# COS_REGION=ap-shanghai
# COS_BUCKET=YOUR_COS_BUCKET_HERE

# ---------------- 6. AI 助手 ----------------
# chat key；也可只设 DEEPSEEK_API_KEY。
AI_CHAT_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
AI_CHAT_BASE_URL=https://api.deepseek.com
AI_CHAT_MODEL=deepseek-chat
# embedding key；也可只设 SILICONFLOW_API_KEY。
AI_EMBEDDING_API_KEY=YOUR_SILICONFLOW_API_KEY_HERE
AI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
AI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# 换维度时必须同时换 AI_COLLECTION。
AI_EMBEDDING_DIMENSIONS=1024
AI_COLLECTION=nitrowater_velochatx_docs
# 联网搜索；key 留空会自动停用。
AI_WEB_SEARCH_ENABLED=true
AI_WEB_SEARCH_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
AI_WEB_SEARCH_ENDPOINT=https://api.deepseek.com/v1/tools/search
AI_WEB_SEARCH_TIMEOUT_MS=20000
# 长期记忆保留 / 清理。
AI_MEMORY_RETENTION_DAYS=180
AI_MEMORY_PURGE_DAYS=30
AI_MEMORY_CLEANUP_CRON=0 15 3 * * *
# 用量明细保留。
AI_USAGE_RETENTION_DAYS=31
AI_USAGE_GLOBAL_RETENTION_DAYS=366
AI_USAGE_CLEANUP_CRON=0 45 4 * * *
# 内容审核：模式在管理端数据库里改，不是环境变量。
AI_MODERATION_DICT=classpath:ai/moderation/words.txt
AI_MODERATION_ALLOW=classpath:ai/moderation/allow.txt
AI_MODERATION_STRIKE_LIMIT=5
AI_MODERATION_STRIKE_WINDOW_MINUTES=10
AI_MODERATION_COOLDOWN_MINUTES=15

# ---------------- 7. 内容挂载（可选） ----------------
# 宿主机内容根目录；默认 deploy/content。
CONTENT_ROOT=../content
# 启用外置词表：取消注释并确保文件存在（必须保留 classpath 基线）。
# AI_MODERATION_DICT=classpath:ai/moderation/words.txt,file:/etc/nitrowater/moderation/words.txt
# AI_MODERATION_ALLOW=classpath:ai/moderation/allow.txt,file:/etc/nitrowater/moderation/allow.txt
# 启用外置语料：目录必须至少有 1 个 .md。
# AI_DOCS_LOCATION=/etc/nitrowater/docs/nitrowater

# ---------------- 8. 发布 / 镜像 ----------------
# 每次发布换新值，旧会话会失效。
APP_SESSION_EPOCH=YOUR_DEPLOY_EPOCH_HERE
# registry 镜像前缀；本地 build 可保持注释。
# REGISTRY=ghcr.io
# GITHUB_REPOSITORY=your-org/nitrowater
# account 独立版本号；CI 用 git sha。
# ACCOUNT_IMAGE_TAG=YOUR_ACCOUNT_TAG_HERE
# app 各服务版本号。
# APP_IMAGE_TAG=YOUR_APP_TAG_HERE

# ============================================================
# 启动（仓库根；docker compose 只自动读 .env，其他文件必须 --env-file）
#
#   docker network create nitrowater-net    # 只需一次
#
#   docker compose --env-file deploy/docker/.env -f deploy/docker/docker-compose.infra.yml up -d
#   docker compose --env-file deploy/docker/.env -f deploy/docker/docker-compose.account.yml up -d
#   docker compose --env-file deploy/docker/.env -f deploy/docker/docker-compose.app.yml up -d
#
# 带公网入口（80/443 + 自动证书）：infra 那条加 --profile edge
# 只更新 account（不碰 mysql/redis/nginx）：account 那条加 --no-deps
# 只重建 app：app 那条加 --build
# ============================================================
