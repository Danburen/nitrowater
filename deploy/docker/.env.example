# ============================================================
# NitroWater 部署环境变量模板（复制为同目录 .env 并填写；.env 已被 .gitignore 排除）
# 本地 dev 可留空（走 compose 默认）；生产需填（逐项见 deploy/env-vars-reference.md「生产必换清单」，尤其 DEVICE_SALT 禁止复用 dev 值）。${VAR:?} 表示缺失即报错。
# 用法：cp deploy/docker/.env.example deploy/docker/.env
# ============================================================

# ---- 数据库 / Redis（infra + app 共用）----
DB_PASSWORD=123456
REDIS_PASSWORD=

# ---- JWT / SSO ----
# 对外可达的 issuer（浏览器与服务都能访问）。生产设 https://auth.nitrowater.cn
JWT_ISSUER=http://localhost:8090
# account 字段加密 KEK（32 字节 Base64）与设备指纹盐
NITROWATER_KEK=
DEVICE_SALT=
# BFF confidential client secret（与 account 播种值一致）
BFF_CLIENT_SECRET=nitrowater-bff-secret
# SSO 回跳地址（生产必填 https；逗号分隔可写多个）
# SSO_DEFAULT_REDIRECT=https://nitrowater.cn
# BFF_REDIRECT_URIS=https://nitrowater.cn/login/oauth2/code/nitrowater
# BFF_POST_LOGOUT_REDIRECT_URIS=https://nitrowater.cn,https://nitrowater.cn/
# 登出后 AS 回跳地址（BFF 使用）；必须是上面列表中的一项，否则 AS 返回 400 空白页且 SSO 会话不销毁
# POST_LOGOUT_REDIRECT_URI=https://nitrowater.cn
# ---- 边缘与暴露面（生产）----
# 默认只绑回环：app 与 infra 的端口在本机可用（浏览器 / SSH 隧道），局域网与公网都不可达。
# 需要用局域网直连调试时才改成 0.0.0.0。
PUBLISH_BIND=127.0.0.1
OPS_BIND=127.0.0.1
# 叠加 docker-compose.edge.yml（生产）时必填；证书由 acme-companion 自动签发 + 续期。
# WEB_DOMAIN 可写逗号列表，例如 nitrowater.cn,www.nitrowater.cn
# WEB_DOMAIN=nitrowater.cn
# AUTH_DOMAIN=auth.nitrowater.cn
# SSL_EMAIL=admin@nitrowater.cn
# HTTPS 部署必须为 true（edge 叠加层会自动注入）；直接跑 compose 时手工设置。
SESSION_COOKIE_SECURE=false

# ---- Verification-code delivery (account) ----
# mock = log codes locally (default); real = SMTP + Aliyun SMS.
COMMUNICATION_MODE=mock
# SMTP (required only when COMMUNICATION_MODE=real)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# Aliyun SMS (required only when COMMUNICATION_MODE=real)
# Credentials use Alibaba Cloud's standard names (the SDK reads the same pair); they are never
# read from application config.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com

# ---- 对象存储（SeaweedFS S3）----
# 资源服务默认后端：s3 | cos | local
RESOURCE_BACKEND=s3
S3_ACCESS_KEY=nitrowater
S3_SECRET_KEY=change-me
S3_BUCKET=nitrowater
# presigned URL 用（浏览器可达）；留空 = 同 S3 内部端点
S3_PUBLIC_ENDPOINT=http://localhost:8333
# presigned 读 URL 缓存余量（秒）：缓存 TTL = 签名有效期 - 该值
RESOURCE_CACHE_MARGIN=60
# 用户上传开关（/api/resource/upload/**）：false 时接口仍在，但返回 503 uploads_disabled。
# 图片等需审核的上传尚未上线，生产建议 false；插件发布（admin / internal）不受影响。
RESOURCE_USER_UPLOAD=true

# ---- 腾讯 COS（可选后端；留空则只用 s3/local）----
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-shanghai
COS_BUCKET=

# ---- 镜像（CI 部署用；本地 build 可忽略）----
REGISTRY=ghcr.io
GITHUB_REPOSITORY=your-org/nitrowater
IMAGE_TAG=latest

# ---- Documentation assistant (Spring AI / RAG + agent) ----
# Chat defaults to DeepSeek. When AI_CHAT_API_KEY is unset, the container falls back to
# DEEPSEEK_API_KEY.
# NOTE: a variable defined as EMPTY still yields an empty key; leave the line commented out
# instead of writing `AI_CHAT_API_KEY=`.
# AI_CHAT_API_KEY=
# Local runs already export DEEPSEEK_API_KEY; uncomment to use it in Docker.
# DEEPSEEK_API_KEY=
AI_CHAT_BASE_URL=https://api.deepseek.com
AI_CHAT_MODEL=deepseek-chat
# Embedding: SiliconFlow Qwen3-Embedding-0.6B (OpenAI-compatible; 1024 dimensions).
# Uses SILICONFLOW_API_KEY; 1024 keeps the existing Qdrant collection size.
# AI_EMBEDDING_API_KEY=
# SILICONFLOW_API_KEY=
AI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
AI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
AI_EMBEDDING_DIMENSIONS=1024

# Long-term memory lifecycle. Unused active entries expire after the retention window;
# user-deleted/expired rows are hard-deleted after the purge window.
AI_MEMORY_RETENTION_DAYS=180
AI_MEMORY_PURGE_DAYS=30
AI_MEMORY_CLEANUP_CRON=0 15 3 * * *
# Usage counters: per-user day rows keep 31 days; the platform-wide (uid=0) day row is kept longer
# so the long-term "site spend" series survives. The global daily quota itself lives in the DB (admin UI).
AI_USAGE_RETENTION_DAYS=31
AI_USAGE_GLOBAL_RETENTION_DAYS=366
# Web search uses DeepSeek's own search API; inactive until DEEPSEEK_API_KEY is set.
# The user must also tick "允许联网" for the turn; the agent is told to call it at most once.
# DEEPSEEK_API_KEY=sk-...
AI_WEB_SEARCH_ENABLED=true
# AI_WEB_SEARCH_API_KEY=            # defaults to DEEPSEEK_API_KEY
# AI_WEB_SEARCH_ENDPOINT=https://api.deepseek.com/v1/tools/search

# ---- Content moderation (violation words) ----
# The posture (off / log / enforce) is a DATABASE setting edited at /admin/ai, not an env var.
# Only INPUT hits feed risk control (strike limit within the window => temporary pause);
# OUTPUT / MEMORY / PROFILE hits are recorded but never penalise the account.
# Leave these commented to use the bundled list. When mounting a fuller list, keep the classpath
# baseline FIRST so a missing mount cannot silently disable the gate (words=0).
# AI_MODERATION_DICT=classpath:ai/moderation/words.txt,file:/etc/nitrowater/moderation/words.txt
# AI_MODERATION_ALLOW=classpath:ai/moderation/allow.txt,file:/etc/nitrowater/moderation/allow.txt
# AI_MODERATION_STRIKE_LIMIT=5
# AI_MODERATION_STRIKE_WINDOW_MINUTES=10
# AI_MODERATION_COOLDOWN_MINUTES=15

# ---- Decoupled content (word lists / doc corpora / skills) ----
# Apply the overlay to enable: docker compose -f docker-compose.app.yml -f docker-compose.content.yml up -d
# Layout + rules: deploy/content/README.md. Defaults below keep the image's classpath content.
# CONTENT_ROOT=D:/nitrowater-content      # host dir with moderation/ docs/ skills/ (default: deploy/content)
# AI_DOCS_LOCATION=/etc/nitrowater/docs/nitrowater   # plain path or file:/... — must hold >=1 .md
#   ^ must contain at least one .md, otherwise that corpus disappears from the index after a rebuild
# AI_SKILLS_DIR=/etc/nitrowater/skills    # external skills dir (built-in classpath skills still apply)
