# ============================================================
# NitroWater 部署环境变量模板（复制为同目录 .env 并填写；.env 已被 .gitignore 排除）
# 本地 dev 可留空（走 compose 默认）；生产需填（逐项见 deploy/env-vars-reference.md「生产必换清单」，尤其 DEVICE_SALT 禁止复用 dev 值）。${VAR:?} 表示缺失即报错。
# 用法：cp deploy/docker/.env.example deploy/docker/.env
# ============================================================

# ---- 数据库 / Redis（infra + app 共用）----
DB_PASSWORD=123456
REDIS_PASSWORD=

# ---- JWT / SSO ----
# 对外可达的 issuer（浏览器与服务都能访问）。生产设 https://auth.nitrowater.cn
JWT_ISSUER=http://localhost:8090
# account 字段加密 KEK（32 字节 Base64）与设备指纹盐
NITROWATER_KEK=
DEVICE_SALT=
# BFF confidential client secret（与 account 播种值一致）
BFF_CLIENT_SECRET=nitrowater-bff-secret

# ---- 对象存储（SeaweedFS S3）----
# 资源服务默认后端：s3 | cos | local
RESOURCE_BACKEND=s3
S3_ACCESS_KEY=nitrowater
S3_SECRET_KEY=change-me
S3_BUCKET=nitrowater
# presigned URL 用（浏览器可达）；留空 = 同 S3 内部端点
S3_PUBLIC_ENDPOINT=http://localhost:8333
# presigned 读 URL 缓存余量（秒）：缓存 TTL = 签名有效期 - 该值
RESOURCE_CACHE_MARGIN=60

# ---- 腾讯 COS（可选后端；留空则只用 s3/local）----
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-shanghai
COS_BUCKET=

# ---- 镜像（CI 部署用；本地 build 可忽略）----
REGISTRY=ghcr.io
GITHUB_REPOSITORY=your-org/nitrowater
IMAGE_TAG=latest

# ---- Documentation assistant (Spring AI / RAG + agent) ----
# Chat defaults to ZhipuAI GLM. When AI_CHAT_API_KEY is unset, the container falls back to
# GLM_API_KEY.
# NOTE: a variable defined as EMPTY still yields an empty key; leave the line commented out
# instead of writing `AI_CHAT_API_KEY=`.
# AI_CHAT_API_KEY=
# Local runs already export GLM_API_KEY; uncomment to use it in Docker.
# GLM_API_KEY=
AI_CHAT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_CHAT_MODEL=glm-5.3-flash
# Embedding: ZhipuAI embedding-3 (OpenAI-compatible; dimensions 256/512/1024/2048).
# Shares the GLM key with chat; 1024 keeps the existing Qdrant collection size.
# AI_EMBEDDING_API_KEY=
AI_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_EMBEDDING_MODEL=embedding-3
AI_EMBEDDING_DIMENSIONS=1024
# Web search uses DeepSeek's own search API; inactive until DEEPSEEK_API_KEY is set.
# The user must also tick "允许联网" for the turn; the agent is told to call it at most once.
# DEEPSEEK_API_KEY=sk-...
AI_WEB_SEARCH_ENABLED=true
# AI_WEB_SEARCH_API_KEY=            # defaults to DEEPSEEK_API_KEY
# AI_WEB_SEARCH_ENDPOINT=https://api.deepseek.com/v1/tools/search
