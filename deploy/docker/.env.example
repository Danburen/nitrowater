# ============================================================
# NitroWater 生产环境变量模板（不含任何真实值；真实 .env 只存在于服务器，且被 gitignore）
#
#   cp deploy/docker/.env.example deploy/docker/.env && chmod 600 deploy/docker/.env
#   bash deploy/bin/check-env.sh          # 必须 0 FAIL
#
# 规则：只有 compose 里 ${VAR} 引用到的键才会进容器；值后面不要写行内注释（# 会变成值的一部分）；
#       YOUR_*_HERE 表示未配置（check-env 会 FAIL）；用不到的整段注释掉。
# 取值方式与逐项要求见 deploy/docs/bootstrap.md §3。
# ============================================================

# ---------------- 1. 共享基础（全部必填） ----------------
# MySQL root：只用于首次建库与人工运维（数据卷已存在后改这里不改库里的口令）。
MYSQL_ROOT_PASSWORD=YOUR_MYSQL_ROOT_PASSWORD_HERE
# 业务连库账号：手工创建；禁止 root，名字只允许 [A-Za-z0-9_]。
DB_USERNAME=nitrowater
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
# Redis：存 BFF 会话与令牌。
REDIS_PASSWORD=YOUR_REDIS_PASSWORD_HERE
# 业务端口只绑回环，公网只经 edge 的 80/443 进入。
PUBLISH_BIND=127.0.0.1
# 运维 UI（Qdrant）只绑回环，禁止 0.0.0.0。
OPS_BIND=127.0.0.1
# 资源字节落盘目录（挂进容器的 /data/resource）：唯一数据面，先建好并纳入备份。
RESOURCE_DATA_DIR=/opt/nitrowater/data/resource

# ---------------- 2. 身份 / SSO ----------------
# 浏览器与服务都可达的 issuer URL，与 AUTH_DOMAIN 一致。
JWT_ISSUER=YOUR_AUTH_ISSUER_URL_HERE
# 32 字节 Base64。丢失 = 加密列永久不可解，生成后离线备份。
NITROWATER_KEK=YOUR_32BYTE_BASE64_KEK_HERE
# 设备指纹盐，禁止用 dev 默认值。
DEVICE_SALT=YOUR_RANDOM_DEVICE_SALT_HERE
# BFF 的 OIDC client secret（account 启动时 upsert）。
BFF_CLIENT_SECRET=YOUR_BFF_CLIENT_SECRET_HERE
# 以下 5 个地址一律写【浏览器看到的公网地址】；换域名要一次性同步（bootstrap §8）。
BFF_REDIRECT_URIS=YOUR_WEB_ORIGIN_HERE/login/oauth2/code/nitrowater
BFF_POST_LOGOUT_REDIRECT_URIS=YOUR_WEB_ORIGIN_HERE,YOUR_WEB_ORIGIN_HERE/
SSO_DEFAULT_REDIRECT=YOUR_WEB_ORIGIN_HERE
SSO_FORM_ACTION_ORIGINS=YOUR_WEB_ORIGIN_HERE,YOUR_AUTH_ORIGIN_HERE
POST_LOGOUT_REDIRECT_URI=YOUR_WEB_ORIGIN_HERE
# 走 HTTPS 时必须 true。
SESSION_COOKIE_SECURE=true

# ---------------- 3. 验证码发送 ----------------
# 生产必须 real（mock 会把验证码写进日志）；real 时邮件与短信两组都必填。
COMMUNICATION_MODE=real
# Resend（HTTP API，无 SMTP）；发件域需已验证 SPF/DKIM。
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE
# 发件人，例如 "NitroWater <no-reply@nitrowater.cn>"。
MAIL_FROM=YOUR_MAIL_FROM_ADDRESS_HERE
# 邮件模板 logo（公网可匿名访问；留空显示文字字标）。
EMAIL_LOGO_URL=YOUR_EMAIL_LOGO_URL_HERE
# 阿里云短信。
ALIBABA_CLOUD_ACCESS_KEY_ID=YOUR_ALIYUN_ACCESS_KEY_ID_HERE
ALIBABA_CLOUD_ACCESS_KEY_SECRET=YOUR_ALIYUN_ACCESS_KEY_SECRET_HERE
ALIYUN_SMS_SIGN_NAME=YOUR_SMS_SIGN_NAME_HERE
ALIYUN_SMS_TEMPLATE_CODE=YOUR_SMS_TEMPLATE_CODE_HERE
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com

# ---------------- 4. 对外地址 ----------------
# edge profile（:80/:443 + 自动证书）用的三个值；填了才会生成 vhost 与证书。
# vhost 侧的额外要求（上传上限、SSE 关缓冲）见 bootstrap §8。
# WEB_DOMAIN=YOUR_WEB_DOMAIN_HERE
# AUTH_DOMAIN=YOUR_AUTH_DOMAIN_HERE
# SSL_EMAIL=YOUR_SSL_EMAIL_HERE
# 跨域白名单：必须写真实域名，禁止 *（带凭证的通配符等于放开所有来源）。
CORS_ALLOWED_ORIGIN_PATTERNS=YOUR_WEB_ORIGIN_HERE,YOUR_AUTH_ORIGIN_HERE

# ---------------- 5. 资源存储 ----------------
# local（字节落 RESOURCE_DATA_DIR）| cos（腾讯云对象存储）。
RESOURCE_BACKEND=local
# 客户端直连存储（presigned）。false = 全走 BFF 的 443 单一入口；local 后端从不签发。
RESOURCE_PRESIGN_ENABLED=false
# resource 接受哪些 aud；默认只认自己（AS 会同时签 server + resource）。
# RESOURCE_JWT_AUDIENCES=nitrowater-resource
# 头像基址：默认留空 = 不下发；启用后填站点 origin，走 /api/public/** 匿名读。
# AVATAR_PICTURE_BASE_URL=
# 客户端缓存余量（秒）。
RESOURCE_CACHE_MARGIN=60
# 上传总闸；角色判定在服务内。false = 一律 503。
RESOURCE_UPLOAD_ENABLED=true
# 单次上传 / 插件 jar 上限（字节）。
RESOURCE_MAX_SIZE=10485760
RESOURCE_PLUGIN_MAX_SIZE=67108864
# 内部发布令牌；留空则 /internal 发布关闭（503）。
RESOURCE_INTERNAL_TOKEN=YOUR_INTERNAL_PUBLISH_TOKEN_HERE
# COS 仅在 RESOURCE_BACKEND=cos 时需要（RESOURCE_DATA_DIR 仍必填，只是不再写入）。
# COS_SECRET_ID=YOUR_COS_SECRET_ID_HERE
# COS_SECRET_KEY=YOUR_COS_SECRET_KEY_HERE
# COS_REGION=ap-shanghai
# COS_BUCKET=YOUR_COS_BUCKET_HERE

# ---------------- 6. AI 助手 ----------------
# chat：AI_CHAT_API_KEY 与 DEEPSEEK_API_KEY 等价，任填一个。
AI_CHAT_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
# DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
AI_CHAT_BASE_URL=https://api.deepseek.com
AI_CHAT_MODEL=deepseek-chat
# embedding：AI_EMBEDDING_API_KEY 与 SILICONFLOW_API_KEY 等价，任填一个。
AI_EMBEDDING_API_KEY=YOUR_SILICONFLOW_API_KEY_HERE
# SILICONFLOW_API_KEY=YOUR_SILICONFLOW_API_KEY_HERE
AI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
AI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# 换维度必须同时换 AI_COLLECTION，否则旧向量不可用。
AI_EMBEDDING_DIMENSIONS=1024
AI_COLLECTION=nitrowater_velochatx_docs
# 联网搜索：key 留空自动停用。
AI_WEB_SEARCH_ENABLED=true
AI_WEB_SEARCH_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
AI_WEB_SEARCH_ENDPOINT=https://api.deepseek.com/v1/tools/search
AI_WEB_SEARCH_TIMEOUT_MS=20000
# 长期记忆保留 / 清理（天）。
AI_MEMORY_RETENTION_DAYS=180
AI_MEMORY_PURGE_DAYS=30
AI_MEMORY_CLEANUP_CRON=0 15 3 * * *
# 用量明细保留（天）。
AI_USAGE_RETENTION_DAYS=31
AI_USAGE_GLOBAL_RETENTION_DAYS=366
AI_USAGE_CLEANUP_CRON=0 45 4 * * *
# 内容审核：词表与阈值（审核模式在管理端库里改，不是环境变量）。
AI_MODERATION_DICT=classpath:ai/moderation/words.txt
AI_MODERATION_ALLOW=classpath:ai/moderation/allow.txt
AI_MODERATION_STRIKE_LIMIT=5
AI_MODERATION_STRIKE_WINDOW_MINUTES=10
AI_MODERATION_COOLDOWN_MINUTES=15
# 代码沙箱地址（容器内）；默认用 compose 自带的 piston。
# PISTON_BASE_URL=http://piston:2000

# ---------------- 7. 内容挂载（可选） ----------------
# 宿主机内容根：docs/（每个子目录一个语料）与 moderation/（词表）都从这里只读挂进容器。
# 生产为 /opt/nitrowater/deploy/content（tarball 解包位置），本地用 ../content。
CONTENT_ROOT=/opt/nitrowater/deploy/content
# 外置词表（取消注释并确保文件存在；必须保留 classpath 基线）。
# AI_MODERATION_DICT=classpath:ai/moderation/words.txt,file:/etc/nitrowater/moderation/words.txt
# AI_MODERATION_ALLOW=classpath:ai/moderation/allow.txt,file:/etc/nitrowater/moderation/allow.txt

# ---------------- 8. 发布 / 镜像 ----------------
# 全员下线不再靠环境变量：account 管理端「会话安全 → 注销全部登录会话」会轮换 Redis 里的
# 会话代次，并清空 SSO 会话与 OAuth2 授权，无需重新发版。
# 免登录绝对上限：从最后一次输密码起算，超过必须重登（默认 30d，BFF 与 account 共用）。
# APP_SESSION_ABSOLUTE=30d
# bff 的 actuator/health 端口（容器内，默认不发布）。
# MANAGEMENT_PORT=9080
# registry 与镜像命名空间（手工排障用；CI 用进程环境变量覆盖）。
REGISTRY=ghcr.io
GITHUB_REPOSITORY=YOUR_GITHUB_OWNER/nitrowater
# account / app 的镜像 tag：留给 CI 注入；手工 up 时再填。
# ACCOUNT_IMAGE_TAG=latest
# APP_IMAGE_TAG=latest
# 文档站镜像：由独立仓库 nitrowater-plugin-docs 的 CI 构建并推送，本仓库只拉。
# 那个仓库每次 push 到 main 都推 :latest 和 :<短 sha>，所以 tag 可以写短 sha（可回滚），也可以写 latest。
# 不填会回落到占位值 → app 单元 pull 失败；私有包先 docker login ghcr.io。
# DOCS_IMAGE_REPO=YOUR_GITHUB_OWNER/nitrowater-plugin-docs
# DOCS_IMAGE_TAG=latest
